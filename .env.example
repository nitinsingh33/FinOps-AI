# Application settings
DATABASE_URL=postgresql+psycopg2://finops:finops_secret@localhost:5432/finops_ai
ASYNC_DATABASE_URL=postgresql+asyncpg://finops:finops_secret@localhost:5432/finops_ai
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_32_RANDOM_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_ROWS_PER_IMPORT=100000

# AI Provider (optional — all deterministic features work without this)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AI_MODEL=gpt-4o-mini
AI_ENABLED=false

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
